# launchd job output
logs/

# The direct injury fetcher's caches and state (sffl injuries-fetch): the
# id crosswalk, Sleeper's player feed, the ESPN-off marker and the last
# snapshot it derives status changes from. Third-party data, never committed.
data/cache/
# Third-party text the direct injury feed and CBS's icon sidecars carry
