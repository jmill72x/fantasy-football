# Licensed subscription data — Draft Sharks / Footballguys / FantasyPros
# exports are paid content. Never commit them to a public repo.
data/extracts
# league-owned history lives in data/league/ and IS tracked
raw/
exports/

# Generated cheatsheets (Excel + PDF) in output/ ARE tracked since 2026-10-30
# (Jeff: keep persistent copies of prior work). They carry only model-derived
# values (MY$, EST$, tier, AVG in league scoring, ranks by MY$) - check every
# new one for vendor columns before staging it.
# The 2026-08-04 layout POC prints FantasyPros' own K/DST auction values
# (its THEIR$ column) and their K/DST order: licensed, never committed.
output/sffl-cheatsheet-poc.pdf
# Excel's lock files while a workbook is open
output/~$*
build/

# Python. No trailing slash on a private path: `x/` matches directories
# only, so a symlink named x (a worktree's .venv or data/weekly link) would
# show as untracked and ride along in a `git add -A` (tests/test_gitignore.py).
.venv
venv
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Weekly stat lines collected from CBS
data/weekly

# Subagent-driven-development scratch workspace
.superpowers

# Playwright profile holding a live CBS login - a credential, never committed
data/browser-profile
# Pages captured from the CBS league site
data/captures

# launchd job output
logs

# The direct injury fetcher's caches and state (sffl injuries-fetch): the
# id crosswalk, Sleeper's player feed, the ESPN-off marker and the last
# snapshot it derives status changes from. Third-party data, never committed.
data/cache
# Third-party text the direct injury feed and CBS's icon sidecars carry
# (ESPN, Sleeper and nflverse rows; CBS labels and news headlines), wherever
# such a file lands. Never committed.
*.direct.json
*.icons.json
